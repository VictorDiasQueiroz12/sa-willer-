{
  "openapi": "3.0.3",
  "info": {
    "title": "FinTech Flow — API de Tesouraria",
    "version": "1.0.0",
    "description": "Valores de resposta em centavos inteiros (strings). Usuários operam sobre os próprios lançamentos; administradores podem operar sobre todos. Exclusões são lógicas e auditadas. Corpos JSON acima de 10 KB retornam 413."
  },
  "servers": [{ "url": "/api", "description": "API na origem atual" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [{ "name": "Sistema" }, { "name": "Sessão" }, { "name": "Transações" }, { "name": "Administração" }],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Sistema"], "summary": "Verificar processo HTTP", "security": [],
        "responses": { "200": { "description": "API disponível", "content": { "application/json": { "example": { "status": "ok" } } } } }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Sessão"], "summary": "Cadastrar operador", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Registration" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Session" }, "400": { "$ref": "#/components/responses/Invalid" }, "409": { "$ref": "#/components/responses/Conflict" }, "429": { "$ref": "#/components/responses/RateLimit" } }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Sessão"], "summary": "Entrar e obter JWT", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Session" }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "429": { "$ref": "#/components/responses/RateLimit" } }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Sessão"], "summary": "Consultar sessão",
        "responses": {
          "200": { "description": "Usuário da sessão", "content": { "application/json": { "schema": { "type": "object", "properties": { "user": { "$ref": "#/components/schemas/User" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": ["Transações"], "summary": "Listar lançamentos",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" }, { "$ref": "#/components/parameters/Type" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" },
          { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/IncludeDeleted" }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Página de lançamentos", "content": { "application/json": { "schema": { "allOf": [
            { "$ref": "#/components/schemas/Page" }, { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } } } }
          ] } } } },
          "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Transações"], "summary": "Criar lançamento",
        "requestBody": { "$ref": "#/components/requestBodies/Transaction" },
        "responses": { "201": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/transactions/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Transações"], "summary": "Consultar lançamento ativo",
        "responses": { "200": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "put": {
        "tags": ["Transações"], "summary": "Atualizar lançamento",
        "requestBody": { "$ref": "#/components/requestBodies/Transaction" },
        "responses": { "200": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      },
      "delete": {
        "tags": ["Transações"], "summary": "Excluir logicamente",
        "responses": { "204": { "description": "Exclusão registrada" }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/transactions/{id}/restore": {
      "post": {
        "tags": ["Administração"], "summary": "Restaurar lançamento excluído (ADMIN)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "$ref": "#/components/responses/Transaction" }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/transactions/balance": {
      "get": {
        "tags": ["Transações"], "summary": "Consultar saldo de lançamentos ativos",
        "parameters": [{ "$ref": "#/components/parameters/Scope" }],
        "responses": { "200": { "description": "Totais ativos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Balance" } } } }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/transactions/monthly": {
      "get": {
        "tags": ["Transações"], "summary": "Consultar totais e despesas do mês",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" },
          { "name": "month", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$", "example": "2026-11" } }
        ],
        "responses": { "200": { "description": "Resumo mensal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Monthly" } } } }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/transactions/export": {
      "get": {
        "tags": ["Transações"], "summary": "Baixar CSV do conjunto filtrado (até 10.000 itens)",
        "parameters": [
          { "$ref": "#/components/parameters/Scope" }, { "$ref": "#/components/parameters/Type" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" },
          { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/IncludeDeleted" }
        ],
        "responses": {
          "200": { "description": "CSV UTF-8 separado por ponto e vírgula", "content": { "text/csv": { "schema": { "type": "string", "format": "binary" } } } },
          "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "422": { "description": "O filtro retornou mais de 10.000 lançamentos" }
        }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Administração"], "summary": "Listar contas (ADMIN)",
        "responses": { "200": { "description": "Contas sem hashes de senha", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/users/{id}/role": {
      "patch": {
        "tags": ["Administração"], "summary": "Alterar o perfil de outra conta (ADMIN)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["role"], "properties": { "role": { "$ref": "#/components/schemas/Role" } } } } } },
        "responses": { "200": { "description": "Conta atualizada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/admin/audit": {
      "get": {
        "tags": ["Administração"], "summary": "Consultar trilha de auditoria (ADMIN)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" },
          { "name": "transactionId", "in": "query", "schema": { "type": "integer", "minimum": 1 } }
        ],
        "responses": {
          "200": { "description": "Página de eventos", "content": { "application/json": { "schema": { "allOf": [
            { "$ref": "#/components/schemas/Page" }, { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEvent" } } } }
          ] } } } },
          "400": { "$ref": "#/components/responses/Invalid" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "Scope": { "name": "scope", "in": "query", "description": "Operadores recebem sempre mine.", "schema": { "type": "string", "enum": ["all", "mine"], "default": "all" } },
      "Type": { "name": "type", "in": "query", "schema": { "$ref": "#/components/schemas/TransactionType" } },
      "From": { "name": "from", "in": "query", "description": "Data inicial inclusiva.", "schema": { "type": "string", "format": "date" } },
      "To": { "name": "to", "in": "query", "description": "Data final inclusiva.", "schema": { "type": "string", "format": "date" } },
      "Search": { "name": "q", "in": "query", "description": "Trecho da descrição ou categoria.", "schema": { "type": "string", "maxLength": 120 } },
      "IncludeDeleted": { "name": "includeDeleted", "in": "query", "description": "Apenas administradores.", "schema": { "type": "boolean", "default": false } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
    },
    "requestBodies": {
      "Transaction": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransactionInput" } } } }
    },
    "responses": {
      "Invalid": { "description": "Dados inválidos ou JSON malformado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Credenciais inválidas ou sessão ausente/expirada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Perfil sem permissão", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Registro inexistente ou fora do escopo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Registro duplicado ou conflito de gravação", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimit": { "description": "Limite de tentativas atingido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Session": { "description": "Sessão autenticada", "content": { "application/json": { "schema": { "type": "object", "required": ["user", "token"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "token": { "type": "string" } } } } } },
      "Transaction": { "description": "Lançamento", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } }
    },
    "schemas": {
      "Role": { "type": "string", "enum": ["USER", "ADMIN"] },
      "TransactionType": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
      "Cents": { "type": "string", "pattern": "^-?[0-9]+$", "example": "200000" },
      "Credentials": {
        "type": "object", "required": ["email", "password"],
        "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password", "maxLength": 72 } }
      },
      "Registration": {
        "allOf": [
          { "$ref": "#/components/schemas/Credentials" },
          { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 80 }, "password": { "type": "string", "minLength": 8, "description": "Deve incluir letras e números e não ultrapassar 72 bytes." } } }
        ]
      },
      "User": {
        "type": "object", "properties": {
          "id": { "type": "integer" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/Role" }, "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TransactionInput": {
        "type": "object", "required": ["description", "amount", "date", "type"], "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 3, "maxLength": 120, "example": "Pagamento de aluguel" },
          "amount": {
            "description": "Valor positivo, até 9 dígitos inteiros e 2 casas. Sem separador de milhares.",
            "oneOf": [{ "type": "string", "pattern": "^[0-9]{1,9}([.,][0-9]{1,2})?$" }, { "type": "number", "minimum": 0.01, "maximum": 999999999.99 }],
            "example": "2000,00"
          },
          "type": { "$ref": "#/components/schemas/TransactionType" },
          "category": { "type": "string", "nullable": true, "maxLength": 60, "example": "Moradia" },
          "date": { "type": "string", "format": "date", "example": "2026-11-22" }
        }
      },
      "Transaction": {
        "type": "object", "properties": {
          "id": { "type": "integer" }, "description": { "type": "string" }, "amountCents": { "$ref": "#/components/schemas/Cents" },
          "type": { "$ref": "#/components/schemas/TransactionType" }, "category": { "type": "string", "nullable": true }, "date": { "type": "string", "format": "date-time" },
          "createdById": { "type": "integer" }, "createdByName": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" },
          "updatedById": { "type": "integer", "nullable": true }, "updatedAt": { "type": "string", "format": "date-time" },
          "deletedById": { "type": "integer", "nullable": true }, "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Totals": {
        "type": "object", "properties": {
          "incomeCents": { "$ref": "#/components/schemas/Cents" }, "expenseCents": { "$ref": "#/components/schemas/Cents" },
          "balanceCents": { "$ref": "#/components/schemas/Cents" }, "scope": { "type": "string", "enum": ["all", "mine"] }
        }
      },
      "Balance": { "allOf": [{ "$ref": "#/components/schemas/Totals" }, { "type": "object", "properties": { "currency": { "type": "string", "enum": ["BRL"] } } }] },
      "Monthly": {
        "allOf": [{ "$ref": "#/components/schemas/Totals" }, { "type": "object", "properties": {
          "month": { "type": "string", "example": "2026-11" }, "count": { "type": "integer" },
          "topExpenses": { "type": "array", "maxItems": 5, "items": { "type": "object", "properties": { "category": { "type": "string", "nullable": true }, "amountCents": { "$ref": "#/components/schemas/Cents" } } } }
        } }]
      },
      "AuditEvent": {
        "type": "object", "properties": {
          "id": { "type": "integer" }, "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE", "RESTORE"] },
          "transactionId": { "type": "integer" }, "userId": { "type": "integer" }, "createdAt": { "type": "string", "format": "date-time" },
          "before": { "type": "object", "nullable": true, "description": "Snapshot no formato Transaction" },
          "after": { "type": "object", "nullable": true, "description": "Snapshot no formato Transaction" },
          "user": { "type": "object", "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" } } }
        }
      },
      "Page": {
        "type": "object", "properties": {
          "page": { "type": "integer" }, "limit": { "type": "integer" }, "total": { "type": "integer" }, "totalPages": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object", "required": ["error"], "properties": {
          "error": { "type": "string" },
          "details": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "message": { "type": "string" } } } }
        }
      }
    }
  }
}
